---
import Layout from '../layouts/Layout.astro';
import galeriaData from '../data/galeria_general.json';

const fotos = galeriaData?.fotos || [];
---
<Layout 
    title="Liceo Trapaqueante - Galería de Imágenes"
    description="Galería de imágenes del Liceo Trapaqueante de Tirúa. Conoce nuestras instalaciones y actividades."
>
    <div class="bg-gray-800 py-12 border-b-4 border-liceo-yellow text-white">
        <div class="max-w-6xl mx-auto px-4 text-center">
            <h1 class="text-4xl font-bold mb-4">Galería de Imágenes</h1>
            <p class="text-lg text-gray-300 max-w-2xl mx-auto">Un recorrido visual por nuestras instalaciones y la vida escolar.</p>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 py-16">
        <!-- Galeria Grid (Desde CMS) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
            
            {fotos.length === 0 ? (
                <div class="col-span-full text-center py-20 bg-gray-50 rounded-lg border-2 border-dashed border-gray-300">
                    <i class="fas fa-images text-4xl text-gray-400 mb-4 block"></i>
                    <p class="text-gray-500 font-medium">Aun no hay fotos en la galeria.</p>
                    <p class="text-sm text-gray-400 mt-2">Puedes agregar fotos desde el Panel de Administracion.</p>
                </div>
            ) : (
                fotos.map((foto) => (
                    <div class="group relative overflow-hidden rounded-lg shadow-sm">
                        <img src={foto} alt="Galeria CMS" class="w-full h-64 object-cover group-hover:scale-110 transition duration-500" />
                    </div>
                ))
            )}

                </div>
            ))}

        </div>
    </div>
</Layout>
