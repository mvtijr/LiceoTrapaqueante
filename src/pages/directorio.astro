---
import Layout from '../layouts/Layout.astro';
---
<Layout 
    title="Liceo Trapaqueante - Equipo Directivo"
    description="Conoce al equipo directivo, UTP, inspectoría y convivencia escolar del Liceo Bicentenario Trapaqueante."
>
    <!-- Header -->
    <div class="bg-liceo-blue py-16 border-b-4 border-liceo-yellow text-white relative overflow-hidden">
        <div class="max-w-6xl mx-auto px-4 text-center relative z-10">
            <h1 class="text-4xl md:text-5xl font-bold mb-4">Nuestro Equipo</h1>
            <p class="text-lg max-w-2xl mx-auto text-blue-200">Liderazgo, vocación y compromiso con la educación de los jóvenes de Tirúa.</p>
        </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 py-16 space-y-16">
        
        <!-- Dirección -->
        <div>
            <h2 class="text-3xl font-bold text-center text-gray-800 mb-10 border-b-2 border-liceo-yellow pb-4 inline-block mx-auto flex justify-center">Dirección</h2>
            <div class="flex justify-center">
                <div class="bg-white p-6 rounded-xl shadow-md border-t-4 border-liceo-blue text-center w-full max-w-sm hover:shadow-xl transition">
                    <div class="w-32 h-32 mx-auto bg-gray-200 rounded-full overflow-hidden mb-4 border-4 border-white shadow flex items-center justify-center text-4xl text-gray-400">
                        <i class="fas fa-user-tie"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-800">Ruth Mónica Colipí Jara</h3>
                    <p class="text-gray-500 mb-4 font-medium">Directora</p>
                    <a href="mailto:director@liceotrapaqueante.cl" class="inline-flex items-center gap-2 text-sm text-liceo-blue hover:underline bg-blue-50 px-4 py-2 rounded-full">
                        <i class="fas fa-envelope"></i> director@liceotrapaqueante.cl
                    </a>
                </div>
            </div>
        </div>

        <!-- UTP e Inspectoría -->
        <div>
            <h2 class="text-3xl font-bold text-center text-gray-800 mb-10 border-b-2 border-liceo-yellow pb-4 inline-block mx-auto flex justify-center">Gestión Educativa</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
                
                <div class="bg-white p-6 rounded-xl shadow-md border-t-4 border-liceo-red text-center hover:shadow-xl transition flex flex-col items-center">
                    <div class="bg-red-50 w-20 h-20 rounded-full flex items-center justify-center text-3xl text-liceo-red mb-4">
                        <i class="fas fa-book-reader"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-800 mb-1">Marianela Carmen Cabezas Avilés</h3>
                    <p class="text-gray-600 font-medium text-sm text-liceo-red">Jefa Unidad Técnica Pedagógica (UTP)</p>
                    <p class="text-gray-600 mb-4 text-sm mt-2 flex-grow">Coordinación de los planes de estudio, evaluación y acompañamiento docente.</p>
                    <a href="mailto:utp@liceotrapaqueante.cl" class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-liceo-red transition mt-auto">
                        <i class="fas fa-envelope"></i> utp@liceotrapaqueante.cl
                    </a>
                </div>

                <div class="bg-white p-6 rounded-xl shadow-md border-t-4 border-liceo-yellow text-center hover:shadow-xl transition flex flex-col items-center">
                    <div class="bg-yellow-50 w-20 h-20 rounded-full flex items-center justify-center text-3xl text-yellow-600 mb-4">
                        <i class="fas fa-user-shield"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-800 mb-1">Victoria de los Ángeles Candia Tapia</h3>
                    <p class="text-gray-600 font-medium text-sm text-yellow-600">Inspectora General</p>
                    <p class="text-gray-600 mb-4 text-sm mt-2 flex-grow">Resguardo de la disciplina, asistencia y buen funcionamiento diario.</p>
                    <a href="mailto:inspectoria@liceotrapaqueante.cl" class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-yellow-600 transition mt-auto">
                        <i class="fas fa-envelope"></i> inspectoria@liceotrapaqueante.cl
                    </a>
                </div>
            </div>
        </div>

        <!-- Convivencia y Orientación -->
        <div>
            <h2 class="text-3xl font-bold text-center text-gray-800 mb-10 border-b-2 border-liceo-yellow pb-4 inline-block mx-auto flex justify-center">Apoyo al Estudiante</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
                
                <div class="bg-white p-6 rounded-xl shadow-md border-t-4 border-liceo-green text-center hover:shadow-xl transition flex flex-col items-center">
                    <div class="bg-green-50 w-20 h-20 rounded-full flex items-center justify-center text-3xl text-liceo-green mb-4">
                        <i class="fas fa-hands-helping"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-800">Convivencia Escolar</h3>
                    <p class="text-gray-600 mb-4 text-sm mt-2 flex-grow">Promoción de un ambiente armónico, resolución de conflictos y bienestar socioemocional escolar.</p>
                    <a href="mailto:convivencia@liceotrapaqueante.cl" class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-liceo-green transition mt-auto">
                        <i class="fas fa-envelope"></i> convivencia@liceotrapaqueante.cl
                    </a>
                </div>

                <div class="bg-white p-6 rounded-xl shadow-md border-t-4 border-blue-400 text-center hover:shadow-xl transition flex flex-col items-center">
                    <div class="bg-blue-50 w-20 h-20 rounded-full flex items-center justify-center text-3xl text-blue-500 mb-4">
                        <i class="fas fa-compass"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-800">Orientación</h3>
                    <p class="text-gray-600 mb-4 text-sm mt-2 flex-grow">Acompañamiento vocacional, psicológico y formativo para el desarrollo personal y profesional.</p>
                    <a href="mailto:orientacion@liceotrapaqueante.cl" class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-blue-500 transition mt-auto">
                        <i class="fas fa-envelope"></i> orientacion@liceotrapaqueante.cl
                    </a>
                </div>
            </div>
        </div>
        
    </div>
</Layout>
