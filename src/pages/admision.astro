---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Liceo Trapaqueante - Admisión">
    <div class="bg-liceo-blue py-12 border-b-4 border-liceo-yellow text-white">
        <div class="max-w-6xl mx-auto px-4 text-center">
            <h1 class="text-4xl font-bold mb-4">Proceso de Admisión</h1>
            <p class="text-lg max-w-2xl mx-auto">Únete a la gran familia del Liceo Trapaqueante.</p>
        </div>
    </div>
    
    <div class="max-w-4xl mx-auto px-4 py-16">
        <div class="bg-white p-8 rounded-lg shadow-md border-t-4 border-liceo-red mb-8">
            <h2 class="text-2xl font-bold text-gray-800 mb-4">Requisitos de Postulación</h2>
            <ul class="list-disc pl-6 space-y-2 text-gray-700">
                <li>Certificado de nacimiento original.</li>
                <li>Certificado de notas del año anterior.</li>
                <li>Informe de personalidad.</li>
                <li>Completar la ficha de postulación presencial u online.</li>
            </ul>
        </div>
    </div>
</Layout>
