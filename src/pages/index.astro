---
import Layout from '../layouts/Layout.astro';
---

<Layout 
    title="Liceo Trapaqueante - Tirúa | Inicio"
    description="Liceo Trapaqueante de Tirúa — Educación integral con identidad cultural Mapuche. Conoce nuestro proceso de admisión y comunidad escolar."
>
    <!-- Banner de Anuncio Importante -->
    <div class="bg-liceo-yellow text-liceo-blue py-2 px-4 text-center font-bold text-sm">
        <i class="fas fa-bullhorn mr-2"></i>
        ¡Proceso de Matrícula 2027 abierto! 
        <a href="/admision" class="underline hover:opacity-75 ml-1">Conoce los requisitos →</a>
    </div>

    <!-- Sección Principal (Hero) -->
    <div class="relative bg-liceo-blue text-white overflow-hidden">
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
            <img class="w-full h-full object-cover scale-150 md:scale-125 opacity-15 mix-blend-multiply" src="/logo.jpg" alt="">
        </div>
        <div class="relative max-w-6xl mx-auto px-4 py-24 md:py-32 flex flex-col items-center text-center">
            <h1 class="text-4xl md:text-5xl font-bold mb-4">Bienvenidos al Liceo Trapaqueante</h1>
            <p class="text-xl mb-8 max-w-2xl">Educación integral, respetando nuestras raíces y formando los líderes del mañana en Tirúa.</p>
            <div class="flex flex-col sm:flex-row gap-4">
                <a href="/admision" class="bg-liceo-yellow text-liceo-blue font-bold py-3 px-8 rounded-full hover:bg-yellow-300 transition transform hover:scale-105 shadow-lg">
                    Proceso de Admisión
                </a>
                <a href="https://www.instagram.com/liceotrapaqueante/" target="_blank" rel="noopener noreferrer" class="bg-transparent border-2 border-white text-white font-bold py-3 px-8 rounded-full hover:bg-white hover:text-liceo-blue transition transform hover:scale-105 shadow-lg">
                    Nuestro Instagram
                </a>
            </div>
        </div>
    </div>

    <!-- Pilares Educativos -->
    <div class="max-w-6xl mx-auto px-4 py-16">
        <h2 class="text-3xl font-bold text-center text-gray-800 mb-12">Nuestros Pilares</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="bg-white p-6 rounded-lg shadow-md text-center border-t-4 border-liceo-blue hover:shadow-xl transition">
                <i class="fas fa-book-reader text-4xl text-liceo-blue mb-4"></i>
                <h3 class="text-xl font-bold mb-2">Excelencia Académica</h3>
                <p class="text-gray-600">Comprometidos con entregar una educación de calidad y herramientas para el futuro.</p>
            </div>
            <div class="bg-white p-6 rounded-lg shadow-md text-center border-t-4 border-liceo-green hover:shadow-xl transition">
                <i class="fas fa-leaf text-4xl text-liceo-green mb-4"></i>
                <h3 class="text-xl font-bold mb-2">Identidad y Cultura</h3>
                <p class="text-gray-600">Valoramos y promovemos la cultura Mapuche y el respeto por nuestro entorno natural.</p>
            </div>
            <div class="bg-white p-6 rounded-lg shadow-md text-center border-t-4 border-liceo-red hover:shadow-xl transition">
                <i class="fas fa-hands-helping text-4xl text-liceo-red mb-4"></i>
                <h3 class="text-xl font-bold mb-2">Comunidad</h3>
                <p class="text-gray-600">Fomentamos la convivencia armónica, la responsabilidad y la solidaridad.</p>
            </div>
        </div>
    </div>

    <!-- Sección MINEDUC Feed -->
    <div class="bg-gray-50 py-16 border-b border-gray-200">
        <div class="max-w-6xl mx-auto px-4">
            <div class="flex justify-between items-center mb-8">
                <h2 class="text-3xl font-bold text-gray-800 border-l-4 border-liceo-blue pl-4">Noticias MINEDUC</h2>
                <a href="/noticias" class="text-liceo-blue font-bold hover:underline hidden md:block">Ver todas las oficiales →</a>
            </div>
            
            <div id="mineduc-news-container-home" class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Skeletons Loading -->
                <div class="animate-pulse bg-white p-6 rounded-lg shadow-sm border border-gray-100 h-48"></div>
                <div class="animate-pulse bg-white p-6 rounded-lg shadow-sm border border-gray-100 h-48 hidden md:block"></div>
                <div class="animate-pulse bg-white p-6 rounded-lg shadow-sm border border-gray-100 h-48 hidden md:block"></div>
            </div>
            
            <div class="mt-6 text-center md:hidden">
                <a href="/noticias" class="text-liceo-blue font-bold hover:underline">Ver todas las oficiales →</a>
            </div>
        </div>
    </div>

    <!-- Script para Mineduc Home -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const rssUrl = 'https://www.mineduc.cl/feed/';
            const apiUrl = `https://api.rss2json.com/v1/api.json?rss_url=${encodeURIComponent(rssUrl)}`;
            const container = document.getElementById('mineduc-news-container-home');

            if (container) {
                fetch(apiUrl)
                    .then(response => response.json())
                    .then(data => {
                        if (data.status === 'ok') {
                            container.innerHTML = ''; 
                            const items = data.items.slice(0, 3);
                            items.forEach(item => {
                                const pubDate = new Date(item.pubDate);
                                const dateString = pubDate.toLocaleDateString('es-CL', { day: '2-digit', month: 'short' });
                                const card = document.createElement('a');
                                card.href = item.link;
                                card.target = "_blank";
                                card.rel = "noopener noreferrer";
                                card.className = "bg-white p-6 rounded-lg shadow-md border-t-4 border-liceo-yellow hover:shadow-xl hover:-translate-y-1 transition duration-300 block group";
                                card.innerHTML = `
                                    <span class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2 block">${dateString}</span>
                                    <h3 class="font-bold text-gray-800 mb-2 group-hover:text-liceo-blue transition line-clamp-3">${item.title}</h3>
                                    <span class="text-liceo-blue font-semibold text-xs group-hover:underline mt-auto inline-block">Leer más →</span>
                                `;
                                container.appendChild(card);
                            });
                        } else {
                            container.innerHTML = '<p class="text-red-500">No se pudieron cargar las noticias del ministerio.</p>';
                        }
                    })
                    .catch(error => console.error('Error fetching MINEDUC:', error));
            }
        });
    </script>

    <!-- Sección Instagram Feed -->
    <div class="bg-gray-100 py-16">
        <div class="max-w-6xl mx-auto px-4">
            <div class="flex justify-between items-center mb-10 text-center md:text-left">
                <div>
                    <h2 class="text-3xl font-bold text-gray-800 flex items-center justify-center md:justify-start gap-3">
                        <i class="fab fa-instagram text-transparent bg-clip-text bg-gradient-to-tr from-yellow-400 via-red-500 to-purple-500"></i>
                        Últimas Novedades
                    </h2>
                    <p class="text-gray-600 mt-2">Síguenos en nuestro Instagram oficial</p>
                </div>
                <a href="https://www.instagram.com/liceotrapaqueante/" target="_blank" rel="noopener noreferrer" class="hidden md:inline-block text-liceo-blue font-bold hover:underline">Ir a Instagram →</a>
            </div>
            
            <!-- Elfsight Instagram Feed -->
            <div class="bg-white p-4 rounded-xl shadow-md border-t-4 border-liceo-red overflow-hidden">
                <script src="https://elfsightcdn.com/platform.js" async></script>
                <div class="elfsight-app-05272784-d07f-4776-92a1-e29110348983" data-elfsight-app-lazy></div>
            </div>
            
            <div class="mt-6 text-center md:hidden">
                <a href="https://www.instagram.com/liceotrapaqueante/" target="_blank" rel="noopener noreferrer" class="text-liceo-blue font-bold hover:underline">Ir a Instagram →</a>
            </div>
        </div>
    </div>

    <!-- Llamado a la Acción: Contacto -->
    <div class="bg-liceo-blue text-white py-16">
        <div class="max-w-4xl mx-auto px-4 text-center">
            <h2 class="text-3xl font-bold mb-4">¿Tienes alguna consulta?</h2>
            <p class="text-lg mb-8 text-blue-200">Nuestro equipo está disponible para orientarte a ti y a tu familia en el proceso de admisión.</p>
            <a href="/contacto" class="bg-liceo-yellow text-liceo-blue font-bold py-3 px-10 rounded-full hover:bg-yellow-300 transition transform hover:scale-105 shadow-lg">
                Contáctanos
            </a>
        </div>
    </div>
</Layout>
