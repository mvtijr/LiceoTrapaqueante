---
import Layout from '../../layouts/Layout.astro';
import acuiculturaData from '../../data/galeria_acuicultura.json';

const fotos = acuiculturaData?.fotos || [];
---
<Layout 
    title="Liceo Trapaqueante - Técnico en Acuicultura"
    description="Especialidad Técnico en Acuicultura del Liceo Trapaqueante."
>
    <!-- Header Especialidad -->
    <div class="bg-liceo-blue py-16 border-b-4 border-liceo-yellow text-white relative overflow-hidden">
        <div class="absolute inset-0 opacity-20">
            <img src="https://images.unsplash.com/photo-1534043464124-3be32fe000c9?ixlib=rb-1.2.1&auto=format&fit=crop&w=1950&q=80" alt="Fondo Acuicultura" class="w-full h-full object-cover">
        </div>
        <div class="max-w-6xl mx-auto px-4 text-center relative z-10">
            <div class="bg-white text-liceo-blue w-16 h-16 rounded-full flex items-center justify-center text-3xl shadow-md mx-auto mb-4">
                <i class="fas fa-fish"></i>
            </div>
            <h1 class="text-4xl md:text-5xl font-bold mb-4">Técnico en Acuicultura</h1>
            <p class="text-lg max-w-2xl mx-auto text-blue-200">Innovación y desarrollo sustentable de nuestros recursos marinos.</p>
        </div>
    </div>

    <!-- Contenido -->
    <div class="max-w-6xl mx-auto px-4 py-16 grid grid-cols-1 md:grid-cols-3 gap-10">
        
        <div class="md:col-span-2 space-y-6">
            <h2 class="text-3xl font-bold text-gray-800 border-b-2 border-liceo-blue pb-2 inline-block">Sobre la Especialidad</h2>
            <p class="text-gray-600 leading-relaxed text-lg">
                Aprovechando el entorno geográfico privilegiado de Tirúa, esta especialidad forma técnicos capaces de participar en los procesos de cultivo, reproducción y manejo de especies acuáticas. Los estudiantes aprenden sobre calidad del agua, alimentación, normativa ambiental y bioseguridad.
            </p>
            
            <h3 class="text-2xl font-bold text-gray-800 mt-10 mb-4"><i class="fas fa-water text-liceo-blue mr-2"></i> Campo Laboral</h3>
            <ul class="list-disc list-inside text-gray-600 text-lg space-y-2 bg-gray-50 p-6 rounded-lg border border-gray-200">
                <li>Centros de cultivo de peces, algas y moluscos</li>
                <li>Plantas de proceso de recursos hidrobiológicos</li>
                <li>Laboratorios de control de calidad de agua y alimentos</li>
                <li>Asistencia técnica en proyectos de desarrollo local</li>
                <li>Emprendimientos acuícolas propios</li>
            </ul>
        </div>

        <!-- Sidebar CTA -->
        <div class="bg-gray-100 p-8 rounded-xl text-center border-t-4 border-liceo-blue self-start">
            <h3 class="text-xl font-bold text-gray-800 mb-2">¿Te gustaría estudiar Acuicultura?</h3>
            <p class="text-gray-600 mb-6">Asegura tu cupo en nuestro proceso de admisión 2027.</p>
            <a href="/admision" class="bg-liceo-blue text-white font-bold py-3 px-6 rounded-full hover:bg-blue-800 transition block shadow-md">
                Postular Ahora
            </a>
            <a href="/especialidades" class="text-sm text-gray-500 mt-4 block hover:underline">← Volver a Especialidades</a>
        </div>
    </div>

    <!-- Galería de Fotos -->
    <div class="bg-white py-16 border-t border-gray-200">
        <div class="max-w-6xl mx-auto px-4">
            <div class="flex justify-between items-center mb-8">
                <div>
                    <h2 class="text-3xl font-bold text-gray-800">Galería de Acuicultura</h2>
                    <p class="text-gray-500 mt-1">Conoce nuestras prácticas y laboratorios.</p>
                </div>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mt-8">
                <!-- Foto Principal Estática -->
                <div class="group relative overflow-hidden rounded-lg shadow-md bg-gray-200 flex items-center justify-center min-h-[250px] md:col-span-2 md:row-span-2">
                    <img src="https://images.unsplash.com/photo-1534043464124-3be32fe000c9?ixlib=rb-1.2.1&auto=format&fit=crop&w=1050&q=80" alt="Cultivo" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-500 opacity-80">
                </div>
                
                <!-- Fotos Dinámicas desde CMS -->
                {fotos.map((foto) => (
                    <div class="group relative overflow-hidden rounded-lg shadow-md min-h-[250px]">
                        <img src={foto} alt="Galería" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition duration-500">
                    </div>
                ))}
            </div>
        </div>
    </div>

</Layout>
