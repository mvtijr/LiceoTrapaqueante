---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Liceo Trapaqueante - Contacto">
    <div class="bg-gray-100 py-12 border-b border-gray-200">
        <div class="max-w-6xl mx-auto px-4 text-center">
            <h1 class="text-4xl font-bold text-liceo-blue mb-4">Contacto</h1>
            <p class="text-lg text-gray-600 max-w-2xl mx-auto">Comunícate con nosotros, resolveremos tus dudas a la brevedad.</p>
        </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 py-16 grid grid-cols-1 md:grid-cols-2 gap-12">
        <div class="bg-white p-8 rounded-lg shadow-md border-t-4 border-liceo-yellow">
            <h2 class="text-2xl font-bold text-gray-800 mb-6">Envíanos un Mensaje</h2>
            <form action="https://formspree.io/f/tu_codigo_aqui" method="POST" class="space-y-4">
                <div>
                    <label class="block text-gray-700 font-bold mb-2">Nombre completo</label>
                    <input type="text" name="name" required class="w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-liceo-blue">
                </div>
                <div>
                    <label class="block text-gray-700 font-bold mb-2">Correo Electrónico</label>
                    <input type="email" name="email" required class="w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-liceo-blue">
                </div>
                <div>
                    <label class="block text-gray-700 font-bold mb-2">Mensaje</label>
                    <textarea name="message" rows="4" required class="w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-2 focus:ring-liceo-blue"></textarea>
                </div>
                <button type="submit" class="bg-liceo-blue text-white font-bold py-3 px-6 rounded-md hover:bg-blue-800 transition w-full">Enviar Mensaje</button>
            </form>
        </div>
        
        <div class="space-y-8">
            <div class="bg-white p-8 rounded-lg shadow-md border-t-4 border-liceo-green">
                <h3 class="text-xl font-bold mb-4 text-gray-800"><i class="fas fa-map-marker-alt text-liceo-red mr-2"></i> Nuestra Ubicación</h3>
                <p class="text-gray-600">Tirúa, Región del Biobío, Chile.</p>
            </div>
            <div class="bg-white p-8 rounded-lg shadow-md border-t-4 border-liceo-blue">
                <h3 class="text-xl font-bold mb-4 text-gray-800"><i class="fas fa-phone text-liceo-blue mr-2"></i> Teléfono</h3>
                <p class="text-gray-600">+56 9 1234 5678</p>
            </div>
        </div>
    </div>
</Layout>
