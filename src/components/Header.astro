---
const currentPath = Astro.url.pathname;
---
<nav class="bg-liceo-blue text-white shadow-lg border-b-4 border-liceo-yellow relative z-50">
    <div class="max-w-7xl mx-auto px-4">
        <div class="flex justify-between items-center py-3">
            <a href="/" class="flex items-center space-x-3 group">
                <img src="/logo.png" alt="Logo Liceo Trapaqueante" class="h-14 w-auto rounded-sm">
                <div class="flex flex-col">
                    <span class="font-bold text-xl leading-tight group-hover:text-liceo-yellow transition">Liceo Trapaqueante</span>
                    <span class="text-liceo-yellow text-sm font-bold tracking-widest">TIRÚA</span>
                </div>
            </a>
            
            <!-- Menú Desktop -->
            <div class="hidden xl:flex font-semibold text-base space-x-6 items-center">
                <a href="/" class={`hover:text-liceo-yellow transition ${currentPath === '/' ? 'text-liceo-yellow' : ''}`}>Inicio</a>
                
                <!-- Dropdown Institución -->
                <div class="relative group">
                    <button class={`hover:text-liceo-yellow transition flex items-center gap-1 h-full py-2 ${(currentPath.includes('/institucion') || currentPath.includes('/pie') || currentPath.includes('/infraestructura') || currentPath.includes('/directorio')) ? 'text-liceo-yellow' : ''}`}>
                        Nosotros <i class="fas fa-chevron-down text-xs ml-1"></i>
                    </button>
                    <div class="absolute left-0 top-full pt-2 w-48 hidden group-hover:block z-50">
                        <div class="bg-white text-gray-800 rounded-md shadow-xl py-2 border-t-4 border-liceo-blue">
                            <a href="/institucion" class="block px-4 py-2 hover:bg-gray-100 hover:text-liceo-blue transition">Institución</a>
                            <a href="/directorio" class="block px-4 py-2 hover:bg-gray-100 hover:text-liceo-blue transition">Equipo Directivo</a>
                            <a href="/pie" class="block px-4 py-2 hover:bg-gray-100 hover:text-liceo-blue transition">Equipo PIE</a>
                            <a href="/infraestructura" class="block px-4 py-2 hover:bg-gray-100 hover:text-liceo-blue transition">Infraestructura</a>
                        </div>
                    </div>
                </div>

                <a href="/especialidades" class={`hover:text-liceo-yellow transition ${currentPath.includes('/especialidades') ? 'text-liceo-yellow' : ''}`}>Especialidades</a>
                
                <!-- Dropdown Comunidad -->
                <div class="relative group">
                    <button class={`hover:text-liceo-yellow transition flex items-center gap-1 h-full py-2 ${(currentPath.includes('/galeria') || currentPath.includes('/calendario') || currentPath.includes('/documentos') || currentPath.includes('/representantes') || currentPath.includes('/convivencia') || currentPath.includes('/exalumnos')) ? 'text-liceo-yellow' : ''}`}>
                        Comunidad <i class="fas fa-chevron-down text-xs ml-1"></i>
                    </button>
                    <div class="absolute left-0 top-full pt-2 w-48 hidden group-hover:block z-50">
                        <div class="bg-white text-gray-800 rounded-md shadow-xl py-2 border-t-4 border-liceo-blue">
                            <a href="/galeria" class="block px-4 py-2 hover:bg-gray-100 hover:text-liceo-blue transition">Galería</a>
                            <a href="/calendario" class="block px-4 py-2 hover:bg-gray-100 hover:text-liceo-blue transition">Calendario Escolar</a>
                            <a href="/representantes" class="block px-4 py-2 hover:bg-gray-100 hover:text-liceo-blue transition">CEAL y CGPA</a>
                            <a href="/convivencia" class="block px-4 py-2 hover:bg-gray-100 hover:text-liceo-blue transition">Convivencia Escolar</a>
                            <a href="/exalumnos" class="block px-4 py-2 hover:bg-gray-100 hover:text-liceo-blue transition">Ex Alumnos</a>
                            <a href="/documentos" class="block px-4 py-2 hover:bg-gray-100 hover:text-liceo-blue transition">Transparencia y Documentos</a>
                        </div>
                    </div>
                </div>

                <!-- Dropdown Admisión -->
                <div class="relative group">
                    <button class={`hover:text-liceo-yellow transition flex items-center gap-1 h-full py-2 ${(currentPath.includes('/admision') || currentPath.includes('/beneficios')) ? 'text-liceo-yellow' : ''}`}>
                        Admisión <i class="fas fa-chevron-down text-xs ml-1"></i>
                    </button>
                    <div class="absolute left-0 top-full pt-2 w-48 hidden group-hover:block z-50">
                        <div class="bg-white text-gray-800 rounded-md shadow-xl py-2 border-t-4 border-liceo-blue">
                            <a href="/admision" class="block px-4 py-2 hover:bg-gray-100 hover:text-liceo-blue transition">Proceso de Admisión</a>
                            <a href="/beneficios" class="block px-4 py-2 hover:bg-gray-100 hover:text-liceo-blue transition">Beneficios JUNAEB</a>
                        </div>
                    </div>
                </div>

                <a href="/contacto" class={`hover:text-liceo-yellow transition ${currentPath.includes('/contacto') ? 'text-liceo-yellow' : ''}`}>Contacto</a>
                
                <!-- Botón Webclass Desktop -->
                <a href="https://plataforma.webescuela.cl/sistema/webclass/" target="_blank" rel="noopener noreferrer" class="bg-liceo-yellow text-liceo-blue px-4 py-2 rounded-lg font-bold hover:bg-yellow-400 transition flex items-center gap-2 shadow-sm ml-2">
                    <i class="fas fa-laptop-house"></i> Webclass
                </a>
            </div>
            
            <!-- Botón Menú Móvil y Webclass Móvil -->
            <div class="flex xl:hidden items-center gap-3">
                <a href="https://plataforma.webescuela.cl/sistema/webclass/" target="_blank" rel="noopener noreferrer" class="bg-liceo-yellow text-liceo-blue px-3 py-1.5 rounded text-sm font-bold shadow-sm">
                    Webclass
                </a>
                <button id="mobile-menu-btn" class="text-white hover:text-liceo-yellow focus:outline-none ml-2">
                    <i class="fas fa-bars text-2xl"></i>
                </button>
            </div>
        </div>
    </div>
    
    <!-- Menú Móvil Desplegable -->
    <div id="mobile-menu" class="hidden xl:hidden bg-liceo-blue border-t border-blue-800">
        <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
            <a href="/" class="block px-3 py-2 text-base font-medium hover:bg-blue-800 hover:text-liceo-yellow border-b border-blue-800">Inicio</a>
            
            <div class="px-3 py-2 text-base font-bold text-blue-200 mt-2">Nosotros</div>
            <a href="/institucion" class="block pl-6 pr-3 py-2 text-sm font-medium hover:bg-blue-800 hover:text-liceo-yellow border-b border-blue-800/50">Institución</a>
            <a href="/directorio" class="block pl-6 pr-3 py-2 text-sm font-medium hover:bg-blue-800 hover:text-liceo-yellow border-b border-blue-800/50">Equipo Directivo</a>
            <a href="/pie" class="block pl-6 pr-3 py-2 text-sm font-medium hover:bg-blue-800 hover:text-liceo-yellow border-b border-blue-800/50">Equipo PIE</a>
            <a href="/infraestructura" class="block pl-6 pr-3 py-2 text-sm font-medium hover:bg-blue-800 hover:text-liceo-yellow border-b border-blue-800">Infraestructura</a>
            
            <a href="/especialidades" class="block px-3 py-2 text-base font-medium hover:bg-blue-800 hover:text-liceo-yellow border-b border-blue-800">Especialidades</a>
            
            <div class="px-3 py-2 text-base font-bold text-blue-200 mt-2">Comunidad</div>
            <a href="/galeria" class="block pl-6 pr-3 py-2 text-sm font-medium hover:bg-blue-800 hover:text-liceo-yellow border-b border-blue-800/50">Galería</a>
            <a href="/calendario" class="block pl-6 pr-3 py-2 text-sm font-medium hover:bg-blue-800 hover:text-liceo-yellow border-b border-blue-800/50">Calendario</a>
            <a href="/representantes" class="block pl-6 pr-3 py-2 text-sm font-medium hover:bg-blue-800 hover:text-liceo-yellow border-b border-blue-800/50">CEAL y CGPA</a>
            <a href="/convivencia" class="block pl-6 pr-3 py-2 text-sm font-medium hover:bg-blue-800 hover:text-liceo-yellow border-b border-blue-800/50">Convivencia Escolar</a>
            <a href="/exalumnos" class="block pl-6 pr-3 py-2 text-sm font-medium hover:bg-blue-800 hover:text-liceo-yellow border-b border-blue-800/50">Ex Alumnos</a>
            <a href="/documentos" class="block pl-6 pr-3 py-2 text-sm font-medium hover:bg-blue-800 hover:text-liceo-yellow border-b border-blue-800">Transparencia y Documentos</a>
            
            <div class="px-3 py-2 text-base font-bold text-blue-200 mt-2">Admisión</div>
            <a href="/admision" class="block pl-6 pr-3 py-2 text-sm font-medium hover:bg-blue-800 hover:text-liceo-yellow border-b border-blue-800/50">Proceso de Admisión</a>
            <a href="/beneficios" class="block pl-6 pr-3 py-2 text-sm font-medium hover:bg-blue-800 hover:text-liceo-yellow border-b border-blue-800">Beneficios JUNAEB</a>
            
            <a href="/contacto" class="block px-3 py-2 text-base font-medium hover:bg-blue-800 hover:text-liceo-yellow mt-2">Contacto</a>
            
            <div class="mt-4 px-3 pb-3">
                <a href="https://plataforma.webescuela.cl/sistema/webclass/" target="_blank" rel="noopener noreferrer" class="block w-full bg-liceo-yellow text-liceo-blue px-4 py-3 rounded-lg font-bold text-center">
                    <i class="fas fa-laptop-house mr-2"></i> Ingresar a Webclass
                </a>
            </div>
        </div>
    </div>
</nav>

<script>
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (btn && menu) {
        btn.addEventListener('click', () => {
            menu.classList.toggle('hidden');
        });
    }
</script>
