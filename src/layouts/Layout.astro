---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Liceo Trapaqueante de Tirúa — Educación integral, respetando nuestras raíces y formando los líderes del mañana.' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://funny-medovik-99700b.netlify.app');
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/jpeg" href="/logo.jpg" />
		<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

		<!-- SEO -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph (para WhatsApp, Facebook, etc.) -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="/logo.jpg" />
		<meta property="og:locale" content="es_CL" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
	</head>
	<body class="bg-gray-50 font-sans flex flex-col min-h-screen relative">
		<!-- Logo de fondo difuminado (Watermark por encima de todo pero sin bloquear clics) -->
		<div class="fixed inset-0 pointer-events-none z-50 flex items-center justify-center overflow-hidden">
			<img 
				src="/logo.jpg" 
				alt="" 
				aria-hidden="true"
				class="w-[600px] max-w-[80vw] opacity-[0.06] blur-sm mix-blend-multiply select-none"
			/>
		</div>
		<Header />
		<main class="flex-grow">
			<slot />
		</main>
		<Footer />
	</body>
</html>
